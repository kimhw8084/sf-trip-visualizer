  },
  "runtime_data_flows": {
    "client_model": "Static generated browser application; local-first Smart map; no account, backend, server-side session, intentional telemetry, analytics, fingerprinting, background POST, or data-upload service.",
    "local_inputs": [
      "Generated canonical trip data, translations, cached route geometry, local photo derivatives, local PMTiles, local glyphs/sprites, and vendored JavaScript/CSS.",
      "User-controlled browser UI events and bounded localStorage preferences."
    ],
    "external_origins": [
      {
        "origin": "https://server.arcgisonline.com",
        "purpose": "Optional user-selected Esri World Imagery tile and health/viewport probes.",
        "data_sent": "Only public map tile coordinates and a bounded probe marker; no credentials or user state.",
        "activation": "User selects Satellite; Smart map does not contact this origin.",
        "failure": "Probe/tile failure returns to local Smart map and preserves planning state.",
        "referrer": "Document meta referrer policy is no-referrer; image probes also set referrerPolicy=no-referrer."
      },
      {
        "origin": "https://www.google.com",
        "purpose": "User-triggered Google Maps directions link for a canonical public place.",
        "data_sent": "Only canonical public geographic place context in the query parameter.",
        "activation": "Explicit user click on a rendered directions link.",
        "referrer": "The link uses noopener noreferrer and the document no-referrer policy."
      }
    ],
    "same_origin_only_core": true,
    "remote_runtime_dependencies": false
  },
  "persisted_state": {
    "storage_keys": {
      "trip_visualizer_runtime_v2": {
        "data_classes": ["primary route, date/region, selected canonical place, mode/sheet/language/theme"],
        "sensitive": false,
        "retention": "Until the user or browser clears localStorage; never transmitted by the application."
      },
      "trip_visualizer_runtime_v1": {
        "data_classes": ["route selection", "region/date filter", "selected canonical place key", "tab/language/theme", "panel dimensions/visibility"],
        "sensitive": false,
        "retention": "Until the user or browser clears localStorage; never transmitted by the application."
      },
      "trip_lang": {"data_classes": ["language preference"], "sensitive": false},
      "trip_theme": {"data_classes": ["theme preference"], "sensitive": false},
      "trip_panel_width": {"data_classes": ["panel width preference"], "sensitive": false},
      "trip_mobile_panel_height": {"data_classes": ["mobile panel height preference"], "sensitive": false}
    },
    "allowed_data_classes": ["non-sensitive UI preference", "non-sensitive planning preference", "canonical public place key"],
    "forbidden_data_classes": ["credentials", "account identifiers", "private photos", "precise user location", "free-form personal notes", "telemetry identifiers"]
  },
  "external_url_policy": {
    "provider_origins": ["https://server.arcgisonline.com"],
    "navigation_origins": ["https://www.google.com"],
    "allowed_scheme": "https",
    "google_navigation_path": "/maps/search/",
    "google_navigation_query": "api=1 plus a canonical public query; no credentials, fragment, or arbitrary origin",
    "new_context_controls": ["rel=noopener", "rel=noreferrer", "referrerpolicy=no-referrer"],
    "canonical_data_may_not_supply_provider_origin": true
  },
  "static_controls": {
    "document_referrer_policy": {"status": "ACTIVE", "mechanism": "meta[name=referrer] content=no-referrer", "scope": "Standalone, modular, and public HTML; response headers remain host-controlled."},
    "https_only_external_endpoints": true,
    "mixed_content": "No intentional HTTP runtime endpoint; external runtime provider and navigation are HTTPS-only.",
    "csp": {"status": "NOT_DEPLOYED", "reason": "GitHub Pages cannot set a response CSP from this repository. A compatible meta CSP would need to permit generated inline data/scripts and standalone data/blob assets; adding a nominal policy that requires unsafe-inline or breaks file delivery would not be a security improvement.", "limitation": "A host-level CSP header remains an operator/deployment control and is not claimed by this gate."},
    "iframe_object_embed": "No maintained runtime use; scanner fails on new iframe/object/embed tags.",
    "workers_blob_data": "No runtime worker; data/blob are used only for standalone/local PMTiles and locally embedded assets as documented.",
    "cdn_runtime_code": false
  },
  "workflow_trust": {
    "candidate": {"trigger": "push to codex/**", "checkout": "exact github.sha", "permissions": {"contents": "read"}, "deploying": false, "secret_access": false, "artifact_upload": "GitHub Actions artifact upload only"},
    "pages": {"trigger": ["push to main", "workflow_dispatch"], "checkout": "exact github.sha", "permissions": {"contents": "read", "pages": "write", "id-token": "write"}, "qualification": "hosted_linux_pipeline.py release --revision github.sha delegates to pipeline.py release --revision github.sha, then verify-public --revision github.sha", "hosted_environment": ["ubuntu-latest", "xvfb-run", "TRIP_CROSS_BROWSER_FIREFOX_MODE=hosted-linux", "LIBGL_ALWAYS_SOFTWARE=1"], "untrusted_candidate_path": "No candidate branch can invoke this workflow or receive Pages/OIDC authority."},
    "forbidden_patterns": ["pull_request_target", "contents: write", "secrets in candidate job", "direct Pages mutation outside canonical pipeline", "workflow command injection from untrusted output"]
  },
  "dependency_update_policy": {
    "reviewed_update_procedure": "Update one dependency or action at a time; obtain upstream release/advisory/license evidence; update exact version/source/hash and this contract; regenerate vendor provenance; run focused tests, pipeline fast, exact candidate qualification, and public/package verification.",
