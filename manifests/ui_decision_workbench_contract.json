{
  "schema_version": 1,
  "project": "sf-trip-visualizer",
  "change": "CHG-157",
  "thesis": "A calm field atlas with a decision cockpit — not a dashboard layered over a map.",
  "source_of_truth": "src/map_shell_template.html plus src/app_phase7.js, src/atlas_state.js, src/atlas_messages.js",
  "task_state": {
    "domain": {
      "primary_route": {"owner": "Decide mode", "persist": true, "preserve_on": ["resize", "orientation", "provider_change", "peek_close", "workbench_collapse"]},
      "date": {"owner": "Day mode", "persist": true, "preserve_on": ["resize", "orientation", "provider_change", "place_close"]},
      "region": {"owner": "Map presentation controls", "persist": true, "preserve_on": ["resize", "orientation", "provider_change"]},
      "selected_place": {"owner": "shared occurrence selection", "persist": true, "discard_on": ["filtered_out", "missing_canonical_place"], "preserve_on": ["resize", "orientation", "provider_change", "mode_change"]},
      "selected_occurrence": {"owner": "shared occurrence selection", "persist": true, "preserve_on": ["day_place_selection", "place_open"]}
    },
    "presentation": {
      "mode": {"values": ["decide", "day", "place"], "owner": "mode navigation", "persist": true, "preserve_on": ["resize", "orientation", "provider_change"]},
      "sheet": {"values": ["compact", "expanded", "full"], "owner": "responsive workbench", "persist": true, "preserve_on": ["orientation", "route_change", "date_change"]},
      "peek": {"owner": "map Peek overlay", "discard_on": ["escape", "outside_map_click", "open_place", "provider_change", "filter_change"]},
      "language": {"owner": "global app bar", "persist": true, "preserve_on": ["all"]},
      "theme": {"owner": "global app bar", "persist": true, "preserve_on": ["all"]},
      "focus_return": {"owner": "overlay/focus controller", "discard_on": ["invalid_invoker", "mode_change"]}
    },
    "runtime": {
      "provider": {"owner": "map provider control", "values": ["vector", "satellite"], "preserve_task_state": true},
      "provider_health": {"owner": "map provider adapter", "values": ["loading", "ready", "failed", "untested"]},
      "local_asset_health": {"owner": "map adapter", "values": ["checking", "ready", "failed"], "preserve_task_state": true},
      "map_status": {"owner": "map shell", "values": ["loading", "ready", "failed"]}
    }
  },
  "surfaces": [
    {"id": "appbar", "kind": "global_identity_actions", "scroll_owner": "document_shell", "focus_owner": "global_actions"},
    {"id": "map", "kind": "persistent_spatial_anchor", "scroll_owner": "map_engine", "focus_owner": "map_markers_and_controls"},
    {"id": "map_controls", "kind": "provider_region_fit", "scroll_owner": "none", "focus_owner": "map_controls"},
    {"id": "peek", "kind": "contextual_place_preview", "scroll_owner": "peek_content", "escape_owner": "peek", "focus_return": "invoker_or_map"},
    {"id": "workbench", "kind": "single_task_workbench", "scroll_owner": "workbench-scroll", "escape_owner": "place_then_sheet", "focus_owner": "mode_navigation"},
    {"id": "decide", "kind": "route_decision", "owner": "workbench", "critical_tasks": ["recommended_route", "switch_rule"]},
    {"id": "day", "kind": "daily_execution", "owner": "workbench", "critical_tasks": ["choose_date", "identify_must_optional_swap_recovery", "bidirectional_selection"]},
    {"id": "place", "kind": "place_inspector", "owner": "workbench", "critical_tasks": ["why_now", "photo_roles", "timing", "replan_rules", "directions", "return_to_prior_context"]}
  ],
  "responsive_contract": {
    "desktop": "Map | one workbench; workbench owns Decide / Day / Place.",
    "mobile": "Map + bottom workbench sheet; same mode and task state, compact/expanded/full are explicit controls.",
    "recomposition": "Never duplicate date, route, provider, or place controls in parallel DOM presentations.",
    "large_text": "Content wraps; no whole-page overflow clipping; workbench-scroll remains the single owned scroll region.",
    "holdout_viewports": ["1366x768", "360x800"]
  },
  "overlay_contract": {"one_contextual_map_overlay": true, "peek_to_inspector_only": true, "escape_order": ["Peek", "Place Inspector", "full_sheet_to_expanded"], "hidden_is_inert": true},
  "task_oracles": [
    {"id": "decide_recommendation", "precondition": "mode=decide", "input": "read recommended card", "oracle": "the configured route is explicitly recommended; human promise, best-for, trade-off, switch rule and regret guard are visible"},
    {"id": "decide_switch", "precondition": "mode=decide", "input": "read switch rule", "oracle": "the recommended single-route plan exposes its decision rules, conditions, and recovery fallbacks"},
    {"id": "day_semantics", "precondition": "mode=day and date selected", "input": "inspect plan", "oracle": "must/core/swap/conditional/bonus/recovery/choice are labeled and non-spatial plan items remain first class"},
    {"id": "place_round_trip", "precondition": "map or Day place available", "input": "open Peek then Inspector then Back", "oracle": "authentic photos, why-now, occurrence context and replan rules are visible; prior mode/date/selection context returns"},
    {"id": "satellite_recovery", "precondition": "Smart map ready", "input": "choose Satellite then induce failure", "oracle": "provider failure stays adjacent, Smart identity is explicit, task/date/place state remains intact"}
  ],
  "legacy_surfaces_removed": ["dateRibbon", "mapSchedule", "mapFocus", "desktop/mobile duplicate date controls", "desktop/mobile duplicate provider controls", "Details tab as a second task authority", "full map-focus mini-detail"],
